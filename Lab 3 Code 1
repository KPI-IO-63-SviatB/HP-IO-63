#include <stdio.h>
#include <stdbool.h>
#include <string.h>

#define STACK_MAX_SIZE 100

typedef struct {
    char bracket;
    int pos; 
} StackItem;

typedef struct {
    StackItem data[STACK_MAX_SIZE];
    int top;
} Stack;

void stack_init(Stack *s) {
    s->top = -1;
}

bool is_empty(const Stack *s) {
    return s->top == -1;
}

bool is_full(const Stack *s) {
    return s->top >= STACK_MAX_SIZE - 1;
}

bool push(Stack *s, StackItem item) {
    if (is_full(s)) {
        return false;
    }
    s->data[++(s->top)] = item;
    return true;
}

bool pop(Stack *s, StackItem *out_item) {
    if (is_empty(s)) {
        return false;
    }
    if (out_item != NULL) {
        *out_item = s->data[s->top];
    }
    (s->top)--;
    return true;
}

bool peek(const Stack *s, StackItem *out_item) {
    if (is_empty(s)) {
        return false;
    }
    if (out_item != NULL) {
        *out_item = s->data[s->top];
    }
    return true;
}
int check_parentheses(const char *str) {
    Stack s;
    stack_init(&s);

    for (int i = 0; str[i] != '\0'; i++) {
        int current_pos = i + 1;

        if (str[i] == '(') {
            StackItem item = {'(', current_pos};
            if (!push(&s, item)) {
                return -1; 
            }
        } else if (str[i] == ')') {
            if (is_empty(&s)) {
                return current_pos;
            }
            pop(&s, NULL);
        }
    }

    if (!is_empty(&s)) {
        int first_unclosed_pos = -1;
        StackItem item;
        while (pop(&s, &item)) {
            first_unclosed_pos = item.pos; 
        }
        return first_unclosed_pos;
    }

    return 0; 
}

int main(void) {
    const char *tests[] = {
        "(a + b) * (c - (d + e))",
        "(()()",
        ")(()",
        "((a + b)",
        "()())()"
    };
    int num_tests = (int)(sizeof(tests) / sizeof(tests[0]));

    for (int i = 0; i < num_tests; i++) {
        int err_pos = check_parentheses(tests[i]);
        printf("Рядок: \"%s\"\n", tests[i]);
        if (err_pos == 0) {
            printf("  Результат: дужки розставлені правильно.\n");
        } else if (err_pos < 0) {
            printf("  Результат: переповнення стека (збільште STACK_MAX_SIZE).\n");
        } else {
            printf("  Результат: помилка на позиції %d.\n", err_pos);
        }
    }

    return 0;
}
