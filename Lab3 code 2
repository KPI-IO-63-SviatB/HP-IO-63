#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    char bracket;
    int pos; 
} StackItem;

typedef struct Node {
    StackItem item;
    struct Node *next;
} Node;

typedef struct {
    Node *top;
} Stack;

void stack_init(Stack *s) {
    s->top = NULL;
}

bool is_empty(const Stack *s) {
    return s->top == NULL;
}

bool is_full(const Stack *s) {
    (void)s;
    return false;
}

bool push(Stack *s, StackItem item) {
    Node *new_node = (Node *)malloc(sizeof(Node));
    if (new_node == NULL) {
        return false;
    }
    new_node->item = item;
    new_node->next = s->top;
    s->top = new_node;
    return true;
}

bool pop(Stack *s, StackItem *out_item) {
    if (is_empty(s)) {
        return false;
    }
    Node *temp = s->top;
    if (out_item != NULL) {
        *out_item = temp->item;
    }
    s->top = temp->next;
    free(temp);
    return true;
}

bool peek(const Stack *s, StackItem *out_item) {
    if (is_empty(s)) {
        return false;
    }
    if (out_item != NULL) {
        *out_item = s->top->item;
    }
    return true;
}

void stack_clear(Stack *s) {
    while (!is_empty(s)) {
        pop(s, NULL);
    }
}

int check_parentheses(const char *str) {
    Stack s;
    stack_init(&s);

    for (int i = 0; str[i] != '\0'; i++) {
        int current_pos = i + 1;

        if (str[i] == '(') {
            StackItem item = {'(', current_pos};
            if (!push(&s, item)) {
                stack_clear(&s);
                return -1;
            }
        } else if (str[i] == ')') {
            if (is_empty(&s)) {
                stack_clear(&s);
                return current_pos;
            }
            pop(&s, NULL);
        }
    }

    if (!is_empty(&s)) {
        int first_unclosed_pos = -1;
        StackItem item;
        while (pop(&s, &item)) {
            first_unclosed_pos = item.pos;
        }
        return first_unclosed_pos;
    }

    return 0;
}

int main(void) {
    const char *tests[] = {
        "(a + b) * (c - (d + e))",
        "(()()",
        ")(()",
        "((a + b)",
        "()())()"
    };
    int num_tests = (int)(sizeof(tests) / sizeof(tests[0]));

    for (int i = 0; i < num_tests; i++) {
        int err_pos = check_parentheses(tests[i]);
        printf("Рядок: \"%s\"\n", tests[i]);
        if (err_pos == 0) {
            printf("  Результат: дужки розставлені правильно.\n");
        } else if (err_pos < 0) {
            printf("  Результат: помилка виділення пам'яті.\n");
        } else {
            printf("  Результат: помилка на позиції %d.\n", err_pos);
        }
    }

    return 0;
}
